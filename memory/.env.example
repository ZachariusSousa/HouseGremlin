# Robit memory — knowledge graph, ingestion driver, web researcher.
# All vars optional; defaults shown are what the code falls back to.
MEMORY_PORT=8092
MEMORY_DB_PATH=data/memory.db
MEMORY_LLM_BASE_URL=http://127.0.0.1:8081/v1
MEMORY_LLM_MODEL=ggml-org/gemma-4-E4B-it-GGUF:Q4_0
MEMORY_LLM_TIMEOUT=30.0
MEMORY_CONTEXT_BUDGET_CHARS=6000
MEMORY_MAX_HOPS=3
MEMORY_BEAM=6
# Bekko embedding server (llama-server --embedding on 8093)
MEMORY_EMBED_BASE_URL=http://127.0.0.1:8093/v1
MEMORY_EMBED_MODEL=bekko
